# ── LifeOS environment template ──
# Copy to .env.local and fill in. Never commit real values.

# Supabase (optional). When BOTH are set, the app requires sign-in and stores data in
# Postgres protected by Row Level Security. When unset, the app runs in local mode
# (data stays in this browser's localStorage, single user, no sign-in).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic API (optional, SERVER ONLY — never prefix with NEXT_PUBLIC_).
# Without it, the planner and assistant use the built-in deterministic engine.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
ANTHROPIC_MODEL=

# ── Optional: notifications when the app is closed (Web Push) ──
# Requires Supabase mode. Generate keys with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact URI, e.g. mailto:you@example.com
VAPID_SUBJECT=
# SERVER ONLY. Used exclusively by /api/cron/reminders to read due reminders for subscribed users.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret; the scheduler must call /api/cron/reminders with "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
