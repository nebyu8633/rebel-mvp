{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "web: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/web" },
      "problemMatcher": [],
      "presentation": { "panel": "dedicated" }
    },
    {
      "label": "web: demo mode",
      "type": "shell",
      "command": "NEXT_PUBLIC_DEMO_MODE=true npm run dev",
      "options": { "cwd": "${workspaceFolder}/web" },
      "problemMatcher": [],
      "presentation": { "panel": "dedicated" }
    },
    {
      "label": "web: build",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/web" },
      "problemMatcher": []
    },
    {
      "label": "web: typecheck",
      "type": "shell",
      "command": "npm run typecheck",
      "options": { "cwd": "${workspaceFolder}/web" },
      "problemMatcher": ["$tsc"],
      "group": "test"
    },
    {
      "label": "web: lint",
      "type": "shell",
      "command": "npm run lint",
      "options": { "cwd": "${workspaceFolder}/web" },
      "problemMatcher": []
    },
    {
      "label": "web: test",
      "type": "shell",
      "command": "npm test",
      "options": { "cwd": "${workspaceFolder}/web" },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "api: dev",
      "type": "shell",
      "command": ".venv/bin/uvicorn app.main:app --reload --port 8000",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "panel": "dedicated" }
    },
    {
      "label": "api: test",
      "type": "shell",
      "command": "DATABASE_URL=sqlite:///:memory: .venv/bin/pytest tests -q",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "api: demo pipeline",
      "type": "shell",
      "command": "DATABASE_URL=sqlite:///:memory: .venv/bin/python scripts/demo_local.py",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "db: start postgres",
      "type": "shell",
      "command": "docker compose up -d db",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
