# PostgreSQL connection string used by SQLAlchemy.
# Matches the credentials in docker-compose.yml by default.
DATABASE_URL=postgresql+psycopg2://invoice_guard:invoice_guard@localhost:5432/invoice_guard

# Vision-capable LLM (Anthropic Claude). Get a key at https://console.anthropic.com/
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5

# WhatsApp Business Cloud API (Meta for Developers -> your app -> WhatsApp -> API Setup)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose - must match the "Verify token" you enter in the
# Meta webhook configuration screen.
WHATSAPP_VERIFY_TOKEN=
# Meta app secret (App Dashboard -> Settings -> Basic -> App Secret).
# Required: inbound webhooks are rejected without it.
WHATSAPP_APP_SECRET=

# Price Guard configuration
PRICE_ALERT_THRESHOLD=0.03
PRICE_ALERT_CRITICAL_THRESHOLD=0.10
MIN_CONFIDENCE=0.85
PRICE_HISTORY_WINDOW_DAYS=60
