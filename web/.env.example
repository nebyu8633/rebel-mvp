# ---------------------------------------------------------------------------
# Supabase
# Create a project at https://supabase.com/dashboard, then copy these from
# Project Settings -> API. Run supabase/migrations/0001_init.sql in the SQL
# editor before first use.
# ---------------------------------------------------------------------------

# Safe to expose to the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses Row Level Security — never prefix with NEXT_PUBLIC_,
# never import into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# AI (vision-capable LLM used to read invoices)
# Anthropic key from https://console.anthropic.com/
# ---------------------------------------------------------------------------
AI_API_KEY=
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Analysis tuning
# ---------------------------------------------------------------------------
# Minimum extraction confidence (0-1) before a line item can drive a
# savings opportunity automatically.
MIN_CONFIDENCE=0.85

# How far back to look for price history, in days.
PRICE_HISTORY_WINDOW_DAYS=365

# Enables the clearly-labelled demo dataset. Never enable in production.
NEXT_PUBLIC_DEMO_MODE=false
