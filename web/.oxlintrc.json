{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "oxc", "nextjs", "jsx-a11y", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "unicorn/no-array-sort": "off",
    "oxc/no-map-spread": "off"
  },
  "ignorePatterns": [
    ".next/**",
    "node_modules/**",
    "next-env.d.ts",
    "scripts/**"
  ]
}
