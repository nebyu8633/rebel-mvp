{
  "name": "lifeos-proto",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Isolated Three.js prototype: realistic character + small urban scene (not part of the LifeOS app)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "assets": "node scripts/fetch-assets.mjs && node scripts/build-assets.mjs && node scripts/fetch-env.mjs && node scripts/build-env.mjs",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run build && npx cap add android 2>/dev/null; npx cap sync android && npx cap open android",
    "cap:ios": "npm run build && npx cap add ios 2>/dev/null; npx cap sync ios && npx cap open ios",
    "avatar": "node scripts/build-avatar.mjs assets-src/avatar-user/avatar.glb"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@capacitor/ios": "^7.6.10",
    "@pmndrs/assets": "^1.7.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@react-three/rapier": "^2.2.0",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "suspend-react": "^0.1.3",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.7.0",
    "ktx2-encoder": "^0.6.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "5.9",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
